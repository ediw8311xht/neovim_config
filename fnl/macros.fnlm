;; [nfnl-macro]

;; .nfnl.fnl config so you don't need to prefix globals like _G.vim.*
;; {:compiler-options {:compilerEnv _G}}

(fn register_binding [{: mode : key}
                      {: typet
                       : val
                       : desc
                       : remap
                       : expr
                       : with_leader
                       : silent}]
  (local with_leader (= with_leader true))
  (local remap (= remap true))
  (var typet (or typet :normal))
  (var key (if with_leader (.. "," key) key))
  (var val val)
  (case (string.lower typet)
    :cmd (set val (.. :<CMD> val :<CR>))
    :vim_command (set val (.. ":" val :<CR>))
    :vim_function (set val (.. ":call " val :<CR>))
    :lua (set val (.. ":lua " val :<CR>))
    :cmd_lua (set val (.. "<CMD>lua " val :<CR>))
    :normal nil)
  `(do
     (vim.keymap.set ,mode ,key ,val
                     {:desc ,desc :remap ,remap :expr ,expr :silent ,silent})
     ,(when desc
        `((. (require :which-key) :add) {1 ,key :desc ,desc :mode ,mode}))))

(fn register_binding_multiple [{ : with_leader } base_table]
  (local result `(do))
  (each [mode sub_table (pairs base_table)]
    (each [key mapping (pairs sub_table)]
      (when (~= with_leader nil) (tset mapping :with_leader with_leader))
      (each [_ i (ipairs (register_binding {: key : mode} mapping))]
        (when (not= i `do)
            (table.insert result i)))))
  result)

{: register_binding : register_binding_multiple}
